[Unit]
Description=Sentinel Security Daemon
After=network.target

[Service]
ExecStart=/usr/local/bin/sentinel
Restart=always
RestartSec=3

StateDirectory=sentinel
LogsDirectory=sentinel

# 🔒 containment
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only

# allow only what it needs
ReadWritePaths=/var/log/sentinel /var/lib/sentinel

# Read protected metadata and process executable links across users.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
