[Unit]
Description=Sentinel Security Daemon
After=network.target

[Service]
ExecStart=/usr/local/bin/sentinel
Restart=always
RestartSec=3

# Containment
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only

# Sentinel needs write access to quarantine files from configured watch dirs.
# Keep runtime state narrow, while allowing enforcement on the default watched paths.
ReadWritePaths=/var/log/sentinel /var/lib/sentinel /tmp /var/tmp /dev/shm /var/www

# /home is monitored by the default config. If quarantine from /home is needed,
# add the specific home subtree here instead of making all home directories writable.
ReadOnlyPaths=/home

# Process enforcement needs CAP_KILL when kill_on_detect=1.
CapabilityBoundingSet=CAP_KILL
AmbientCapabilities=CAP_KILL
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
